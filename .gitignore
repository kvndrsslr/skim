# macOS Finder metadata
.DS_Store
._*

# Xcode build output / derived data (this checkout writes them under build/,
# which holds DerivedData/, DerivedDataRelease/ and the build-*.log files)
build/
DerivedData*/

# Xcode project workspace — regenerated by Xcode; this repo tracks no skeleton
# inside it, so the whole directory is ignored (covers vendored projects too)
project.xcworkspace/

# Xcode per-user state
xcuserdata/
*.xcuserstate

# Xcode leftovers
*.moved-aside
*.dSYM/

# The .DS_Store files committed in this repo are deliberately kept visible so
# they do not register as "tracked but ignored" (see git ls-files -ci). The
# unanchored .DS_Store rule above still ignores any new untracked .DS_Store.
!/.DS_Store
!/Assets.xcassets/.DS_Store
!/QuickLook-Skim/.DS_Store
!/SkimImporter/.DS_Store
!/SkimNotes/.DS_Store
!/SkimQuickLookPreview/.DS_Store
!/SkimTransitions/.DS_Store
!/Templates/.DS_Store
!/vendorsrc/.DS_Store
